{
  "ConnectionStrings": {
    "ITrace": "Server=.;Database=invensys.itrace;Integrated Security=SSPI;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "ITrace": {
    "PerformanceCounters": {
      "Enabled": true,
      "CollectionIntervalSeconds": 60,
      "GraphIntervalMinutes": 5,
      "SampleRetentionHours": 48,
      "CpuAlertPercent": 90,
      "MemoryAlertPercent": 90,
      "DiskAlertPercent": 90,
      "NetworkAlertBytesPerSecond": 104857600
    },
    "SeedApplications": [
      {
        "Name": "Integra Flow",
        "Environment": "Production",
        "Description": "Seed DSN for Integra Flow telemetry."
      },
      {
        "Name": "iServe",
        "Environment": "Production",
        "Description": "Seed DSN for iServe telemetry."
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
